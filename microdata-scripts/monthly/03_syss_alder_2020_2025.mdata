require no.ssb.fdb:52 as db

create-dataset q2020q1
import db/BEFOLKNING_STATUSKODE 2020-01-01 as regstatus
keep if regstatus == '1'
import db/BEFOLKNING_FOEDSELS_AAR_MND as fodtaarmd
import db/ARBLONN_PERS_SUM_STILLINGSPST 2020-01-16 as stillingspst
generate alder = 2020 - int(fodtaarmd / 100)
generate sysselsatt = 0
replace sysselsatt = 1 if stillingspst > 0
tabulate sysselsatt alder, flatten
delete-dataset q2020q1

