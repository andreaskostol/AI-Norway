import db/ARBLONN_ARB_YRKE_STYRK08 2023-09-16 as yrke
import db/ARBLONN_FRTK_SEKTOR_2014 2023-09-16 as sektor
import db/ARBLONN_LONN_KONTANT_IMP 2023-09-16 as kontantlonn
import db/ARBLONN_ARB_STILLINGSPST 2023-09-16 as stillingspst
import db/ARBLONN_LONN_TIME 2023-09-16 as timelonn
import db/ARBLONN_LONN_OVERTID_TIMER 2023-09-16 as overtid_timer
replace overtid_timer = 0 if sysmiss(overtid_timer)
import db/ARBLONN_ARB_START 2023-09-16 as startdato
generate yrke4 = substr(yrke, 1, 4)

generate sekt = 2
replace sekt = 1 if sektor == '1110'
replace sekt = 1 if sektor == '1120'
replace sekt = 1 if sektor == '6100'
replace sekt = 1 if sektor == '1510'
replace sekt = 1 if sektor == '1520'
replace sekt = 1 if sektor == '6500'

generate ny_jobb = 0
replace ny_jobb = 1 if startdato > 19585 & startdato <= 19616

use kobling
merge personid into jobb_y2023m09
use pers
merge fodtaarmd into jobb_y2023m09 on personid

use jobb_y2023m09
generate birth_yr = int(fodtaarmd / 100)
generate birth_mo = fodtaarmd - birth_yr * 100
generate alder = 2023 - birth_yr
replace alder = alder - 1 if birth_mo > 9
generate alder_gr = 0
replace alder_gr = 1 if alder >= 21 & alder <= 30
replace alder_gr = 2 if alder >= 31 & alder <= 40
replace alder_gr = 3 if alder >= 41 & alder <= 50
replace alder_gr = 4 if alder >= 51 & alder <= 60
replace alder_gr = 5 if alder >= 61

tabulate yrke4 alder_gr sekt, flatten
