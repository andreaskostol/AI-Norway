replace alder_gr = 7 if alder >= 50 & alder <= 59
replace alder_gr = 8 if alder >= 60 & alder <= 69
replace alder_gr = 9 if alder >= 70
generate ny_jobb = 0
replace ny_jobb = 1 if startdato > 19616 & startdato <= 19646
tabulate yrke4 alder_gr, summarize(overtid_timer) flatten
tabulate yrke4 alder_gr, summarize(ny_jobb) flatten
delete-dataset y2023m10

