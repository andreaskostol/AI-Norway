require no.ssb.fdb:52 as db

create-dataset kobling
import db/ARBEIDSFORHOLD_PERSON as personid

create-dataset pers
import db/BEFOLKNING_FOEDSELS_AAR_MND as fodtaarmd

create-dataset y2021m01
import db/ARBLONN_ARB_YRKE_STYRK08 2021-01-16 as yrke
import db/ARBLONN_LONN_OVERTID_TIMER 2021-01-16 as overtid_timer
replace overtid_timer = 0 if sysmiss(overtid_timer)
import db/ARBLONN_ARB_START 2021-01-16 as startdato
generate yrke4 = substr(yrke, 1, 4)

use kobling
merge personid into y2021m01
use pers
merge fodtaarmd into y2021m01 on personid

use y2021m01
generate birth_yr = int(fodtaarmd / 100)
generate birth_mo = fodtaarmd - birth_yr * 100
generate alder = 2021 - birth_yr
replace alder = alder - 1 if birth_mo > 1
generate alder_gr = 0
replace alder_gr = 1 if alder <= 21
replace alder_gr = 2 if alder >= 22 & alder <= 25
replace alder_gr = 3 if alder >= 26 & alder <= 30
replace alder_gr = 4 if alder >= 31 & alder <= 34
replace alder_gr = 5 if alder >= 35 & alder <= 40
replace alder_gr = 6 if alder >= 41 & alder <= 49
replace alder_gr = 7 if alder >= 50 & alder <= 59
replace alder_gr = 8 if alder >= 60 & alder <= 69
replace alder_gr = 9 if alder >= 70
generate ny_jobb = 0
replace ny_jobb = 1 if startdato > 18612 & startdato <= 18643
tabulate yrke4 alder_gr, summarize(overtid_timer) flatten
tabulate yrke4 alder_gr, summarize(ny_jobb) flatten
delete-dataset y2021m01

create-dataset y2021m02
import db/ARBLONN_ARB_YRKE_STYRK08 2021-02-16 as yrke
