require no.ssb.fdb:52 as db

create-dataset kobling
import db/ARBEIDSFORHOLD_PERSON as personid

create-dataset pers2020
import db/BEFOLKNING_FOEDSELS_AAR_MND as fodtaarmd
generate alder = 2020 - int(fodtaarmd / 100)

create-dataset pers2021
import db/BEFOLKNING_FOEDSELS_AAR_MND as fodtaarmd
generate alder = 2021 - int(fodtaarmd / 100)

create-dataset pers2022
import db/BEFOLKNING_FOEDSELS_AAR_MND as fodtaarmd
generate alder = 2022 - int(fodtaarmd / 100)

create-dataset pers2023
import db/BEFOLKNING_FOEDSELS_AAR_MND as fodtaarmd
generate alder = 2023 - int(fodtaarmd / 100)

create-dataset pers2024
import db/BEFOLKNING_FOEDSELS_AAR_MND as fodtaarmd
generate alder = 2024 - int(fodtaarmd / 100)

create-dataset pers2025
import db/BEFOLKNING_FOEDSELS_AAR_MND as fodtaarmd
generate alder = 2025 - int(fodtaarmd / 100)

create-dataset y2020m06
import db/ARBLONN_ARB_YRKE_STYRK08 2020-06-16 as yrke
import db/ARBLONN_LONN_KONTANT_IMP 2020-06-16 as kontantlonn
import db/ARBLONN_ARB_STILLINGSPST 2020-06-16 as stillingspst
import db/ARBLONN_LONN_TIME 2020-06-16 as timelonn
generate yrke4 = substr(yrke, 1, 4)

use kobling
merge personid into y2020m06
use pers2020
merge alder into y2020m06 on personid

use y2020m06
generate alder_gr = 0
replace alder_gr = 1 if alder <= 21
replace alder_gr = 2 if alder >= 22 & alder <= 25
replace alder_gr = 3 if alder >= 26 & alder <= 30
replace alder_gr = 4 if alder >= 31 & alder <= 34
replace alder_gr = 5 if alder >= 35 & alder <= 40
replace alder_gr = 6 if alder >= 41 & alder <= 49
replace alder_gr = 7 if alder >= 50 & alder <= 59
replace alder_gr = 8 if alder >= 60 & alder <= 69
replace alder_gr = 9 if alder >= 70
tabulate yrke4 alder_gr, summarize(kontantlonn) flatten
tabulate yrke4 alder_gr, summarize(stillingspst) flatten
tabulate yrke4 alder_gr, summarize(timelonn) flatten
delete-dataset y2020m06

