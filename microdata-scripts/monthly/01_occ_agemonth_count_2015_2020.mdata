replace alder_gr = 3 if alder >= 26 & alder <= 30
replace alder_gr = 4 if alder >= 31 & alder <= 34
replace alder_gr = 5 if alder >= 35 & alder <= 40
replace alder_gr = 6 if alder >= 41 & alder <= 49
replace alder_gr = 7 if alder >= 50 & alder <= 59
replace alder_gr = 8 if alder >= 60 & alder <= 69
replace alder_gr = 9 if alder >= 70
tabulate yrke4 alder_gr, flatten
delete-dataset y2020m10

create-dataset y2020m11
import db/ARBLONN_ARB_YRKE_STYRK08 2020-11-16 as yrke
generate yrke4 = substr(yrke, 1, 4)

use kobling
merge personid into y2020m11
use pers
merge fodtaarmd into y2020m11 on personid

use y2020m11
generate birth_yr = int(fodtaarmd / 100)
generate birth_mo = fodtaarmd - birth_yr * 100
generate alder = 2020 - birth_yr
replace alder = alder - 1 if birth_mo > 11
generate alder_gr = 0
replace alder_gr = 1 if alder <= 21
replace alder_gr = 2 if alder >= 22 & alder <= 25
replace alder_gr = 3 if alder >= 26 & alder <= 30
replace alder_gr = 4 if alder >= 31 & alder <= 34
replace alder_gr = 5 if alder >= 35 & alder <= 40
replace alder_gr = 6 if alder >= 41 & alder <= 49
replace alder_gr = 7 if alder >= 50 & alder <= 59
replace alder_gr = 8 if alder >= 60 & alder <= 69
replace alder_gr = 9 if alder >= 70
tabulate yrke4 alder_gr, flatten
delete-dataset y2020m11

create-dataset y2020m12
import db/ARBLONN_ARB_YRKE_STYRK08 2020-12-16 as yrke
generate yrke4 = substr(yrke, 1, 4)

use kobling
merge personid into y2020m12
use pers
merge fodtaarmd into y2020m12 on personid

use y2020m12
generate birth_yr = int(fodtaarmd / 100)
generate birth_mo = fodtaarmd - birth_yr * 100
generate alder = 2020 - birth_yr
replace alder = alder - 1 if birth_mo > 12
generate alder_gr = 0
replace alder_gr = 1 if alder <= 21
replace alder_gr = 2 if alder >= 22 & alder <= 25
replace alder_gr = 3 if alder >= 26 & alder <= 30
replace alder_gr = 4 if alder >= 31 & alder <= 34
replace alder_gr = 5 if alder >= 35 & alder <= 40
replace alder_gr = 6 if alder >= 41 & alder <= 49
replace alder_gr = 7 if alder >= 50 & alder <= 59
replace alder_gr = 8 if alder >= 60 & alder <= 69
replace alder_gr = 9 if alder >= 70
tabulate yrke4 alder_gr, flatten
delete-dataset y2020m12
