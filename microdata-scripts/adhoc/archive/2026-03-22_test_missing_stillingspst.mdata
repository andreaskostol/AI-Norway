require no.ssb.fdb:51 as db

create-dataset test_miss
import db/BEFOLKNING_STATUSKODE 2025-01-01 as regstatus
keep if regstatus == '1'

import db/BEFOLKNING_FOEDSELS_AAR_MND as fodtaarmd
generate alder = 2025 - int(fodtaarmd / 100)
keep if alder >= 25 & alder <= 54

import db/ARBLONN_PERS_SUM_STILLINGSPST 2025-01-16 as stillingspst

generate har_missing = 0
replace har_missing = 1 if sysmiss(stillingspst)

generate har_jobb = 0
replace har_jobb = 1 if stillingspst > 0

generate status = 1
replace status = 2 if stillingspst > 0 & stillingspst < 100
replace status = 3 if stillingspst >= 100

define-labels statuslbl 1 'Uten/missing' 2 'Deltid (<100)' 3 'Heltid (>=100)'
assign-labels status statuslbl

tabulate har_missing, flatten
tabulate status, flatten
summarize stillingspst
